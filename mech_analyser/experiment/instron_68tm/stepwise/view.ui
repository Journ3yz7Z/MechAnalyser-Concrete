   </item>
   <item row="0" column="3">
    <widget class="QDoubleSpinBox" name="sb_RelaxationStrainsStart">
     <property name="toolTip">
      <string>The step between consecutive strains at which the sample has been configured to relax.  This in combination with the number of intervals gives the relaxation strains.  For instance, if the step size is 5%, and the number of intervals is 6, then the experiment will relax the sample at 5%, 10%, 15%, 20%, 25%, 30%.</string>
     </property>
     <property name="suffix">
      <string>%</string>
     </property>
     <property name="decimals">
      <number>1</number>
